#!/usr/bin/env bash
# ==============================================================================
# 🚀 HOPDIS — Universal Linux & Windows-to-Linux Zero-ReLogin Migrator Engine
# ==============================================================================
set -e

# ANSI Color Palette
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_CYAN="\033[38;2;86;182;194m"
C_GREEN="\033[38;2;152;195;121m"
C_YELLOW="\033[38;2;229;192;123m"
C_RED="\033[38;2;224;108;117m"
C_MAGENTA="\033[38;2;198;120;221m"
C_BLUE="\033[38;2;97;175;239m"

print_banner() {
    clear 2>/dev/null || true
    echo -e "${C_CYAN}${C_BOLD}"
    cat << 'BANNER'
  _    _  ____  _____  _____ _____  _____ 
 | |  | |/ __ \|  __ \|  __ \_   _|/ ____|
 | |__| | |  | | |__) | |  | || | | (___  
 |  __  | |  | |  ___/| |  | || |  \___ \ 
 | |  | | |__| | |    | |__| || |_ ____) |
 |_|  |_|\____/|_|    |_____/_____|_____/ 
BANNER
    echo -e "${C_MAGENTA}  Universal Linux State & Zero-ReLogin Migrator Engine${C_RESET}"
    echo -e "${C_DIM}  Developed for Distro-Hoppers & OS Switchers by Kaarlyz${C_RESET}"
    echo -e "${C_CYAN}══════════════════════════════════════════════════════════════════════${C_RESET}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODULES_DIR="$SCRIPT_DIR/modules"

source "$MODULES_DIR/detect_os.sh"
source "$MODULES_DIR/backup_packages.sh"
source "$MODULES_DIR/backup_browsers.sh"
source "$MODULES_DIR/backup_chat.sh"
source "$MODULES_DIR/restore_packages.sh"
source "$MODULES_DIR/restore_sessions.sh"
source "$MODULES_DIR/restore_windows.sh"
source "$MODULES_DIR/sanity_check.sh"
source "$MODULES_DIR/cloud_sync.sh"
source "$MODULES_DIR/tui_menu.sh"

detect_os_family
eval "$(detect_os_family)"

show_help() {
    print_banner
    echo -e "\n${C_BOLD}CARA PENGGUNAAN:${C_RESET}"
    echo -e "  ${C_GREEN}./backup.sh${C_RESET} [output_dir] [--all]   ${C_DIM}→ Buat paket backup sesi & konfigurasi lengkap${C_RESET}"
    echo -e "  ${C_GREEN}./restore.sh${C_RESET} <file_backup>         ${C_DIM}→ Pulihkan sesi & software di distro baru${C_RESET}"
    echo -e "  ${C_GREEN}./bin/hop cloud${C_RESET}                    ${C_DIM}→ Menu interaktif Cloud Storage (Google Drive Uploader/Downloader)${C_RESET}"
    echo -e "  ${C_GREEN}./bin/hop check${C_RESET}                    ${C_DIM}→ Jalankan sanity report & cek integritas sistem${C_RESET}"
    echo -e "  ${C_GREEN}./bin/hop info${C_RESET}                     ${C_DIM}→ Cek status deteksi OS & aplikasi aktif${C_RESET}\n"
}

run_backup() {
    local out_dir="${1:-$SCRIPT_DIR}"
    local force_all="$2"
    local timestamp
    timestamp="$(date +%Y%m%d_%H%M%S)"
    local bundle_name="distrohop_backup_${timestamp}"
    local temp_dir="/tmp/${bundle_name}"

    print_banner
    echo -e "${C_BLUE}ℹ  Target OS:${C_RESET} ${C_BOLD}$OS_NAME ($OS_FAMILY)${C_RESET}  |  ${C_BLUE}Package Manager:${C_RESET} ${C_BOLD}$PKG_MGR${C_RESET}\n"

    mkdir -p "$temp_dir" "$out_dir"

    local selected_components
    if [ "$force_all" = "--all" ] || [ "$force_all" = "-a" ]; then
        selected_components='"PACKAGES" "BROWSERS" "CHAT" "AI_STACK" "DEV_KEYS" "DESKTOP"'
    else
        selected_components="$(select_backup_components)"
    fi

    echo -e "${C_BOLD}${C_YELLOW}▶ [1/3] MEMPROSES KOMPONEN CADANGAN...${C_RESET}"

    if echo "$selected_components" | grep -q "PACKAGES"; then
        echo -e "  ${C_CYAN}•${C_RESET} Mengekspor manifest aplikasi & package..."
        export_packages "$temp_dir"
    fi

    if echo "$selected_components" | grep -q "BROWSERS"; then
        echo -e "  ${C_CYAN}•${C_RESET} Mengekspor profil & sesi login browser..."
        export_browsers "$temp_dir"
    fi

    if echo "$selected_components" | grep -q "CHAT" || echo "$selected_components" | grep -q "AI_STACK" || echo "$selected_components" | grep -q "DEV_KEYS" || echo "$selected_components" | grep -q "DESKTOP"; then
        echo -e "  ${C_CYAN}•${C_RESET} Mengekspor Telegram tdata, AI Agents (Hermes/9Router), SSH Keys & Dotfiles..."
        export_all_discovered_sessions "$temp_dir"
    fi

    echo -e "\n${C_BOLD}${C_YELLOW}▶ [2/3] MENGOMPRES SELURUH DATA STATE...${C_RESET}"
    local archive_path
    if command -v zstd >/dev/null 2>&1; then
        archive_path="${out_dir}/${bundle_name}.tar.zst"
        tar -I 'zstd -19 -T0' -cf "$archive_path" -C "/tmp" "$bundle_name"
    else
        archive_path="${out_dir}/${bundle_name}.tar.gz"
        tar -czf "$archive_path" -C "/tmp" "$bundle_name"
    fi

    rm -rf "$temp_dir"
    echo -e "\n${C_BOLD}${C_YELLOW}▶ [3/3] VERIFIKASI INTEGRITAS CADANGAN...${C_RESET}"
    if [ -f "$archive_path" ]; then
        local file_size
        file_size="$(du -h "$archive_path" | cut -f1)"
        echo -e "${C_GREEN}${C_BOLD}✔ SUKSES! File arsip cadangan siap dipindahkan:${C_RESET}"
        echo -e "  ${C_BOLD}Lokasi :${C_RESET} ${C_CYAN}$archive_path${C_RESET}"
        echo -e "  ${C_BOLD}Ukuran :${C_RESET} ${C_MAGENTA}$file_size${C_RESET}\n"

        # Ask for cloud upload if interactive
        if command -v whiptail >/dev/null 2>&1 && [ -t 0 ] && [ "$force_all" != "--all" ]; then
            if whiptail --title "Upload ke Cloud Storage" --yesno "Apakah Anda ingin mengunggah file backup ini langsung ke Google Drive / Cloud Storage?" 10 65; then
                interactive_cloud_menu
            fi
        fi
    else
        echo -e "${C_RED}✖ Terjadi kesalahan saat membuat file arsip.${C_RESET}"
        exit 1
    fi
}

run_restore() {
    local archive_file="$1"
    if [ -z "$archive_file" ] || [ ! -f "$archive_file" ]; then
        # Check if user wants to download from cloud
        if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
            if whiptail --title "File Tidak Ditemukan" --yesno "File backup lokal tidak ditemukan.\n\nApakah Anda ingin mengunduhnya dari Google Drive / Cloud Storage?" 12 60; then
                interactive_cloud_menu
                archive_file="$(find "$SCRIPT_DIR" -maxdepth 1 -name "distrohop_backup_*.tar.*" -o -name "hopdis_windows_migration_*.zip" 2>/dev/null | sort -r | head -n 1)"
            fi
        fi
    fi

    if [ -z "$archive_file" ] || [ ! -f "$archive_file" ]; then
        print_banner
        echo -e "${C_RED}✖ Error: File arsip backup tidak ditemukan!${C_RESET}"
        echo -e "Contoh penggunaan: ${C_CYAN}./restore.sh distrohop_backup_20260924_190000.tar.zst${C_RESET}\n"
        exit 1
    fi

    print_banner
    echo -e "${C_BLUE}ℹ  Distro Target:${C_RESET} ${C_BOLD}$OS_NAME ($OS_FAMILY)${C_RESET}  |  ${C_BLUE}Package Manager:${C_RESET} ${C_BOLD}$PKG_MGR${C_RESET}\n"

    local temp_extract="/tmp/distrohop_restore_temp"
    rm -rf "$temp_extract"
    mkdir -p "$temp_extract"

    echo -e "${C_BOLD}${C_YELLOW}▶ [1/3] MENGEKSTRAK ARSIP CADANGAN...${C_RESET}"
    if [[ "$archive_file" == *.zip ]]; then
        unzip -q "$archive_file" -d "$temp_extract"
    elif [[ "$archive_file" == *.tar.zst ]]; then
        tar -I zstd -xf "$archive_file" -C "$temp_extract"
    else
        tar -xzf "$archive_file" -C "$temp_extract"
    fi

    local bundle_dir
    bundle_dir="$(find "$temp_extract" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
    if [ -z "$bundle_dir" ] || [ ! -d "$bundle_dir/browsers" -a ! -d "$bundle_dir/sessions" ]; then
        bundle_dir="$temp_extract"
    fi

    echo -e "\n${C_BOLD}${C_YELLOW}▶ [2/3] MENGANALISIS & MEMASANG SOFTWARE DEPENDENSI...${C_RESET}"
    if [ -f "$bundle_dir/manifests/windows_installed_apps.txt" ]; then
        map_windows_alternatives "$bundle_dir/manifests/windows_installed_apps.txt" "$OS_FAMILY" "$PKG_MGR"
    elif [ -d "$bundle_dir/manifests" ]; then
        install_manifests "$bundle_dir" "$OS_FAMILY" "$PKG_MGR"
    fi

    echo -e "\n${C_BOLD}${C_YELLOW}▶ [3/3] MEMULIHKAN PROFILE BROWSER, SESI LOGIN, & AI STACK...${C_RESET}"
    restore_all_sessions "$bundle_dir"

    rm -rf "$temp_extract"
    echo -e "\n${C_GREEN}${C_BOLD}══════════════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}🎉 RESTORISASI SELESAI 100%! MENJALANKAN SANITY CHECK...${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}══════════════════════════════════════════════════════════════════════${C_RESET}\n"

    run_sanity_check
}

case "$1" in
    backup)
        run_backup "$2" "$3"
        ;;
    restore)
        run_restore "$2"
        ;;
    check)
        print_banner
        run_sanity_check
        ;;
    cloud)
        print_banner
        interactive_cloud_menu
        ;;
    info)
        print_banner
        echo -e "${C_BOLD}STATUS DETEKSI SISTEM:${C_RESET}"
        echo -e "  ${C_CYAN}• OS Name   :${C_RESET} $OS_NAME ($OS_ID)"
        echo -e "  ${C_CYAN}• OS Family :${C_RESET} $OS_FAMILY"
        echo -e "  ${C_CYAN}• Pkg Mgr   :${C_RESET} $PKG_MGR\n"
        echo -e "${C_BOLD}STATUS APLIKASI & SESI:${C_RESET}"
        [ -d "$HOME/.mozilla/firefox" ] && echo -e "  ${C_GREEN}✔ Firefox Profile${C_RESET}"
        [ -d "$HOME/.config/google-chrome" ] && echo -e "  ${C_GREEN}✔ Google Chrome Session${C_RESET}"
        [ -d "$HOME/.config/BraveSoftware" ] && echo -e "  ${C_GREEN}✔ Brave Browser Session${C_RESET}"
        [ -d "$HOME/.local/share/TelegramDesktop/tdata" ] && echo -e "  ${C_GREEN}✔ Telegram Desktop (tdata session)${C_RESET}"
        [ -d "$HOME/.hermes" ] && echo -e "  ${C_GREEN}✔ Hermes AI Agent (Skills, Memory, Config)${C_RESET}"
        [ -d "$HOME/.9router" ] && echo -e "  ${C_GREEN}✔ 9Router AI Gateway (Auth & Tokens)${C_RESET}"
        [ -d "$HOME/.local/share/antigravity" ] && echo -e "  ${C_GREEN}✔ Antigravity CLI State${C_RESET}"
        [ -d "$HOME/.local/share/opencode" ] && echo -e "  ${C_GREEN}✔ OpenCode CLI State${C_RESET}"
        echo ""
        ;;
    *)
        show_help
        ;;
esac
