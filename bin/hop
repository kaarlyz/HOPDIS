#!/usr/bin/env bash
# ==============================================================================
# 🚀 HOPDIS — Universal Linux & Windows-to-Linux Zero-ReLogin Migrator Engine
# ==============================================================================
set -e

# ANSI TrueColor & 256-Color Modern Palette
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_ITALIC="\033[3m"
C_CYAN="\033[38;2;86;182;194m"
C_GREEN="\033[38;2;152;195;121m"
C_YELLOW="\033[38;2;229;192;123m"
C_RED="\033[38;2;224;108;117m"
C_PURPLE="\033[38;2;198;120;221m"
C_BLUE="\033[38;2;97;175;239m"
C_BG_DARK="\033[48;2;40;44;52m"
C_WHITE="\033[38;2;255;255;255m"

# Modern Whiptail Theme Colors (Newt compatibility)
export NEWT_COLORS='
root=white,black
window=white,black
border=cyan,black
shadow=black,gray
title=magenta,black
button=black,cyan
actbutton=black,white
compactbutton=white,black
checkbox=cyan,black
actcheckbox=black,cyan
entry=white,black
label=white,black
listbox=white,black
actlistbox=black,cyan
textbox=white,black
acttextbox=black,cyan
helpline=white,black
roottext=white,black
'

print_banner() {
    clear 2>/dev/null || true
    echo -e "${C_CYAN}${C_BOLD}"
    cat << 'BANNER'
  ╭────────────────────────────────────────────────────────────────────╮
  │   _    _  ____  _____  _____ _____  _____                          │
  │  | |  | |/ __ \|  __ \|  __ \_   _|/ ____|                         │
  │  | |__| | |  | | |__) | |  | || | | (___                           │
  │  |  __  | |  | |  ___/| |  | || |  \___ \                          │
  │  | |  | | |__| | |    | |__| || |_ ____) |                         │
  │  |_|  |_|\____/|_|    |_____/_____|_____/                          │
  │                                                                    │
  │   Universal Linux State & Zero-ReLogin Migrator Engine             │
  │   Developed for Distro-Hoppers & OS Switchers by Kaarlyz           │
  ╰────────────────────────────────────────────────────────────────────╯
BANNER
    echo -e "${C_RESET}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODULES_DIR="$SCRIPT_DIR/modules"

source "$MODULES_DIR/detect_os.sh"
source "$MODULES_DIR/backup_packages.sh"
source "$MODULES_DIR/backup_browsers.sh"
source "$MODULES_DIR/backup_chat.sh"
source "$MODULES_DIR/restore_packages.sh"
source "$MODULES_DIR/restore_sessions.sh"
source "$MODULES_DIR/restore_windows.sh"
source "$MODULES_DIR/sanity_check.sh"
source "$MODULES_DIR/cloud_sync.sh"
source "$MODULES_DIR/tui_menu.sh"

detect_os_family
eval "$(detect_os_family)"

show_help() {
    print_banner
    echo -e "${C_PURPLE}${C_BOLD}⚡ PERINTAH CEPAT (COMMANDS):${C_RESET}"
    echo -e "  ${C_GREEN}${C_BOLD}hop backup${C_RESET} [output_dir] [--all]  ${C_DIM}│ Cadangkan sesi, browser, AI & kredensial${C_RESET}"
    echo -e "  ${C_GREEN}${C_BOLD}hop restore${C_RESET} <file_backup>        ${C_DIM}│ Pulihkan seluruh sistem & sesi di distro baru${C_RESET}"
    echo -e "  ${C_GREEN}${C_BOLD}hop cloud${C_RESET}                        ${C_DIM}│ Menu Cloud Storage (Google Drive Upload/Download)${C_RESET}"
    echo -e "  ${C_GREEN}${C_BOLD}hop check${C_RESET}                        ${C_DIM}│ Cek status integritas & kesehatan sistem${C_RESET}"
    echo -e "  ${C_GREEN}${C_BOLD}hop info${C_RESET}                         ${C_DIM}│ Tampilkan deteksi OS & modul aktif${C_RESET}\n"
}

run_backup() {
    local out_dir="${1:-$SCRIPT_DIR}"
    local force_all="$2"
    local timestamp
    timestamp="$(date +%Y%m%d_%H%M%S)"
    local bundle_name="distrohop_backup_${timestamp}"
    local temp_dir="/tmp/${bundle_name}"

    print_banner
    echo -e "  ${C_BLUE}┌─ 💻 DISTRO AKTIF :${C_RESET} ${C_BOLD}$OS_NAME ($OS_FAMILY)${C_RESET}"
    echo -e "  ${C_BLUE}└─ 📦 PACKAGE MGR  :${C_RESET} ${C_BOLD}$PKG_MGR${C_RESET}\n"

    mkdir -p "$temp_dir" "$out_dir"

    local selected_components
    if [ "$force_all" = "--all" ] || [ "$force_all" = "-a" ]; then
        selected_components='"PACKAGES" "BROWSERS" "CHAT" "AI_STACK" "DEV_KEYS" "DESKTOP"'
    else
        selected_components="$(select_backup_components)"
    fi

    echo -e "${C_YELLOW}${C_BOLD}╭─ 🚀 [1/3] EKSTRAKSI STATE & SESI LOGIN...${C_RESET}"

    if echo "$selected_components" | grep -q "PACKAGES"; then
        echo -e "${C_YELLOW}│${C_RESET}  ${C_CYAN}◆${C_RESET} [Manifests] Menginventarisir paket APT/Pacman/Flatpak/Snap/NPM..."
        export_packages "$temp_dir" >/dev/null 2>&1 || true
        echo -e "${C_YELLOW}│${C_RESET}    ${C_GREEN}✔ Manifest berhasil dicatat${C_RESET}"
    fi

    if echo "$selected_components" | grep -q "BROWSERS"; then
        echo -e "${C_YELLOW}│${C_RESET}  ${C_CYAN}◆${C_RESET} [Browsers] Mengkloning profile Chrome, Brave, Firefox & Cookies..."
        export_browsers "$temp_dir" >/dev/null 2>&1 || true
        echo -e "${C_YELLOW}│${C_RESET}    ${C_GREEN}✔ Profile & sesi browser diamankan (Cache dibersihkan)${C_RESET}"
    fi

    if echo "$selected_components" | grep -q "CHAT" || echo "$selected_components" | grep -q "AI_STACK" || echo "$selected_components" | grep -q "DEV_KEYS" || echo "$selected_components" | grep -q "DESKTOP"; then
        echo -e "${C_YELLOW}│${C_RESET}  ${C_CYAN}◆${C_RESET} [AI & Dev] Menyelamatkan Hermes, 9Router, Antigravity, SSH & Telegram tdata..."
        export_all_discovered_sessions "$temp_dir" >/dev/null 2>&1 || true
        echo -e "${C_YELLOW}│${C_RESET}    ${C_GREEN}✔ Kunci enkripsi, AI memory, dan tdata sesi tersalin utuh${C_RESET}"
    fi
    echo -e "${C_YELLOW}╰────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

    echo -e "${C_PURPLE}${C_BOLD}╭─ 🗜️  [2/3] MENGOMPRES DATA KE ULTRA-FAST ZSTD...${C_RESET}"
    local archive_path
    if command -v zstd >/dev/null 2>&1; then
        archive_path="${out_dir}/${bundle_name}.tar.zst"
        tar -I 'zstd -19 -T0' -cf "$archive_path" -C "/tmp" "$bundle_name"
    else
        archive_path="${out_dir}/${bundle_name}.tar.gz"
        tar -czf "$archive_path" -C "/tmp" "$bundle_name"
    fi
    rm -rf "$temp_dir"
    echo -e "${C_PURPLE}╰────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

    echo -e "${C_GREEN}${C_BOLD}╭─ ✨ [3/3] VERIFIKASI & RINGKASAN CADANGAN${C_RESET}"
    if [ -f "$archive_path" ]; then
        local file_size
        file_size="$(du -h "$archive_path" | cut -f1)"
        echo -e "${C_GREEN}│${C_RESET}  ${C_BOLD}Status  :${C_RESET} ${C_GREEN}SUKSES (Siap Dipindahkan)${C_RESET}"
        echo -e "${C_GREEN}│${C_RESET}  ${C_BOLD}File    :${C_RESET} ${C_CYAN}$archive_path${C_RESET}"
        echo -e "${C_GREEN}│${C_RESET}  ${C_BOLD}Ukuran  :${C_RESET} ${C_PURPLE}$file_size${C_RESET}"
        echo -e "${C_GREEN}╰────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

        if command -v whiptail >/dev/null 2>&1 && [ -t 0 ] && [ "$force_all" != "--all" ]; then
            if whiptail --title "HOPDIS — Upload Cloud Storage" --yesno "Cadangan lokal selesai dibuat ($file_size).\n\nApakah Anda ingin mengunggah file ini langsung ke Google Drive?" 12 65; then
                interactive_cloud_menu
            fi
        fi
    else
        echo -e "${C_RED}✖ Gagal mengompresi data cadangan.${C_RESET}"
        exit 1
    fi
}

run_restore() {
    local archive_file="$1"
    if [ -z "$archive_file" ] || [ ! -f "$archive_file" ]; then
        if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
            if whiptail --title "HOPDIS — Unduh Cadangan" --yesno "File arsip cadangan lokal tidak ditemukan di folder ini.\n\nApakah Anda ingin mengunduhnya dari Google Drive sekarang?" 12 65; then
                interactive_cloud_menu
                archive_file="$(find "$SCRIPT_DIR" -maxdepth 1 -name "distrohop_backup_*.tar.*" -o -name "hopdis_windows_migration_*.zip" 2>/dev/null | sort -r | head -n 1)"
            fi
        fi
    fi

    if [ -z "$archive_file" ] || [ ! -f "$archive_file" ]; then
        print_banner
        echo -e "${C_RED}✖ Error: File arsip cadangan tidak ditemukan!${C_RESET}"
        echo -e "Contoh: ${C_CYAN}hop restore distrohop_backup_20260924_190000.tar.zst${C_RESET}\n"
        exit 1
    fi

    print_banner
    echo -e "  ${C_BLUE}┌─ 🎯 DISTRO TUJUAN :${C_RESET} ${C_BOLD}$OS_NAME ($OS_FAMILY)${C_RESET}"
    echo -e "  ${C_BLUE}└─ 📦 PACKAGE MGR   :${C_RESET} ${C_BOLD}$PKG_MGR${C_RESET}\n"

    local temp_extract="/tmp/distrohop_restore_temp"
    rm -rf "$temp_extract"
    mkdir -p "$temp_extract"

    echo -e "${C_YELLOW}${C_BOLD}╭─ 📂 [1/3] MENGEKSTRAK ARSIP CADANGAN...${C_RESET}"
    if [[ "$archive_file" == *.zip ]]; then
        unzip -q "$archive_file" -d "$temp_extract"
    elif [[ "$archive_file" == *.tar.zst ]]; then
        tar -I zstd -xf "$archive_file" -C "$temp_extract"
    else
        tar -xzf "$archive_file" -C "$temp_extract"
    fi

    local bundle_dir
    bundle_dir="$(find "$temp_extract" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
    if [ -z "$bundle_dir" ] || [ ! -d "$bundle_dir/browsers" -a ! -d "$bundle_dir/sessions" ]; then
        bundle_dir="$temp_extract"
    fi
    echo -e "${C_YELLOW}╰── ✔ Data cadangan berhasil diekstrak.${C_RESET}\n"

    echo -e "${C_CYAN}${C_BOLD}╭─ 📦 [2/3] MENGINSTALL DEPENDENSI, RUNTIME & FLATPAK...${C_RESET}"
    if [ -f "$bundle_dir/manifests/windows_installed_apps.txt" ]; then
        map_windows_alternatives "$bundle_dir/manifests/windows_installed_apps.txt" "$OS_FAMILY" "$PKG_MGR"
    elif [ -d "$bundle_dir/manifests" ]; then
        install_manifests "$bundle_dir" "$OS_FAMILY" "$PKG_MGR"
    fi
    echo -e "${C_CYAN}╰── ✔ Seluruh dependensi & toolchain siap.${C_RESET}\n"

    echo -e "${C_PURPLE}${C_BOLD}╭─ 🔄 [3/3] MEMULIHKAN PROFILE BROWSER, SESI CHAT, & AI AGENTS...${C_RESET}"
    restore_all_sessions "$bundle_dir"
    rm -rf "$temp_extract"
    echo -e "${C_PURPLE}╰── ✔ Sesi, perizinan kunci SSH, dan systemd services diaktifkan.${C_RESET}\n"

    echo -e "${C_GREEN}${C_BOLD}╭────────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}│  🎉 RESTORISASI SELESAI 100%! SELURUH SESI BERHASIL DIPULIHKAN.   │${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}╰────────────────────────────────────────────────────────────────────╯${C_RESET}\n"

    run_sanity_check
}

case "$1" in
    backup)
        run_backup "$2" "$3"
        ;;
    restore)
        run_restore "$2"
        ;;
    check)
        print_banner
        run_sanity_check
        ;;
    cloud)
        print_banner
        interactive_cloud_menu
        ;;
    info)
        print_banner
        echo -e "${C_BOLD}STATUS DETEKSI SISTEM:${C_RESET}"
        echo -e "  ${C_CYAN}┌─ OS Name   :${C_RESET} $OS_NAME ($OS_ID)"
        echo -e "  ${C_CYAN}├─ OS Family :${C_RESET} $OS_FAMILY"
        echo -e "  ${C_CYAN}└─ Pkg Mgr   :${C_RESET} $PKG_MGR\n"
        echo -e "${C_BOLD}STATUS APLIKASI & SESI:${C_RESET}"
        [ -d "$HOME/.mozilla/firefox" ] && echo -e "  ${C_GREEN}✔${C_RESET} Firefox Profile & Cookies"
        [ -d "$HOME/.config/google-chrome" ] && echo -e "  ${C_GREEN}✔${C_RESET} Google Chrome Session"
        [ -d "$HOME/.config/BraveSoftware" ] && echo -e "  ${C_GREEN}✔${C_RESET} Brave Browser Session"
        [ -d "$HOME/.local/share/TelegramDesktop/tdata" ] && echo -e "  ${C_GREEN}✔${C_RESET} Telegram Desktop (tdata session)"
        [ -d "$HOME/.hermes" ] && echo -e "  ${C_GREEN}✔${C_RESET} Hermes AI Agent (Skills, Memory, Config)"
        [ -d "$HOME/.9router" ] && echo -e "  ${C_GREEN}✔${C_RESET} 9Router AI Gateway (Auth & Tokens)"
        [ -d "$HOME/.local/share/antigravity" ] && echo -e "  ${C_GREEN}✔${C_RESET} Antigravity CLI State"
        [ -d "$HOME/.local/share/opencode" ] && echo -e "  ${C_GREEN}✔${C_RESET} OpenCode CLI State"
        echo ""
        ;;
    *)
        show_help
        ;;
esac
